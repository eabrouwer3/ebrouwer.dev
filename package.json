{
	"name": "ebrouwer.dev-sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_OPTIONS='--max-old-space-size=8192' vite build",
		"build:prod": "NODE_OPTIONS='--max-old-space-size=8192' vite build --mode production",
		"start": "node build/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "vite-node --options.transformMode.ssr='/.*/' src/lib/server/database.seed.ts"
	},
	"devDependencies": {
		"@dnd-kit-svelte/core": "^0.0.8",
		"@dnd-kit-svelte/modifiers": "^0.0.8",
		"@dnd-kit-svelte/sortable": "^0.0.8",
		"@dnd-kit-svelte/utilities": "^0.0.8",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@flydotio/dockerfile": "^0.7.10",
		"@google-cloud/compute": "^6.0.0",
		"@google-cloud/firestore": "^7.11.3",
		"@internationalized/date": "^3.8.2",
		"@lucide/lab": "^0.1.2",
		"@lucide/svelte": "^0.515.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-node": "^5.2.13",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tabler/icons-svelte": "^3.34.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/vite": "^4.0.0",
		"@tanstack/table-core": "^8.21.3",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/pg": "^8.15.5",
		"axios": "^1.11.0",
		"better-auth": "^1.3.4",
		"better-call": "^1.0.13",
		"bits-ui": "^2.9.1",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"dotenv": "^17.2.1",
		"drizzle-kit": "^0.31.4",
		"drizzle-orm": "^0.44.4",
		"drizzle-zod": "^0.8.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"highlight.js": "^11.11.1",
		"layerchart": "2.0.0-next.27",
		"mode-watcher": "^1.1.0",
		"pg": "^8.16.3",
		"postgres": "^3.4.7",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.0.5",
		"sveltekit-superforms": "^2.27.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.0.0",
		"tsx": "^4.20.3",
		"tw-animate-css": "^1.3.6",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^7.0.4",
		"vite-node": "^3.2.4",
		"vite-plugin-devtools-json": "^0.2.0",
		"zod": "^4.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"protobufjs"
		]
	}
}
